# Скопируйте этот файл в .env и подставьте свои значения.
# Моковый ключ: OpenRouter будет возвращать 401, пока его не замените.
OPENROUTER_API_KEY=sk-or-v1-mock-key-put-your-real-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Секрет для подписи JWT — замените на случайный
JWT_SECRET=dev-secret-please-change

# SQLite сейчас, Postgres позже:
# postgresql+psycopg://user:pass@localhost:5432/ai_chat
DATABASE_URL=sqlite:///./chat.db

# Лимит токенов на пользователя (промпт всей истории + ответ, по usage OpenRouter)
TOKEN_LIMIT=1000
# Длина окна в минутах; окна выровнены по UTC: 1440 → сброс в 00:00 UTC, 2 → каждые 2 минуты
TOKEN_LIMIT_PERIOD_MINUTES=1440
# Оценка токенов, если провайдер не прислал usage
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4