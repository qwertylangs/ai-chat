# Скопируйте этот файл в .env и подставьте свои значения.
# Моковый ключ: OpenRouter будет возвращать 401, пока его не замените.
OPENROUTER_API_KEY=sk-or-v1-mock-key-put-your-real-key-here
OPENROUTER_MODEL=openai/gpt-4o

# Секрет для подписи JWT — замените на случайный
JWT_SECRET=dev-secret-please-change

# SQLite сейчас, Postgres позже:
# postgresql+psycopg://user:pass@localhost:5432/ai_chat
DATABASE_URL=sqlite:///./chat.db