#!/bin/sh
# Гоняем линт и unit-тесты фронта/бэка. Пропускаем каждый, если в коммите нет изменений под его папкой.
set -e

if git diff --cached --name-only | grep -q '^front/'; then
  echo "pre-commit: front lint + unit tests"
  cd front
  npm run lint
  npm test -- --run
  cd ..
fi

if git diff --cached --name-only | grep -q '^api/'; then
  echo "pre-commit: api tests"
  cd api
  uv run pytest -q
fi
